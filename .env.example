HOST=0.0.0.0
PORT=4300
SESSION_TTL_DAYS=14
PUBLIC_ORIGIN=http://127.0.0.1:4300
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=平台管理员
# 留空则首次启动随机生成初始口令并写入日志，或设置你自己的强口令；请勿沿用示例口令。
ADMIN_PASSWORD=
# 生产环境经 HTTPS 提供服务时设为 true，使会话 Cookie 携带 Secure 属性（PUBLIC_ORIGIN 为 https 时自动开启）。
COOKIE_SECURE=false
# 实例网关端口绑定地址，默认 127.0.0.1（仅本机可达）；确需对外暴露时才改为 0.0.0.0。
OPENCLAW_RUNNER_BIND_HOST=127.0.0.1
OPENCLAW_RUNNER_IMAGE=ghcr.io/jimizhou/clawbot-openclaw-runner:latest
OPENCLAW_RUNNER_PULL_TIMEOUT_MS=600000
OPENCLAW_RUNNER_CPUS=1.0
OPENCLAW_RUNNER_MEMORY=1g
OPENCLAW_WECHAT_BIND_TIMEOUT_MS=600000
